{
  "name": "backend-central-zarco",
  "version": "0.1.0",
  "description": "Backend central de negocio (La Fija) — NestJS + Postgres, dueño de menú/pedidos/pagos/delivery/promociones.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "e2e:real-db": "jest --config ./test/real-db-e2e/jest.config.json --runInBand",
    "e2e:cleanup": "ts-node scripts/e2e-cleanup.ts",
    "migrate": "node-pg-migrate --migration-file-language sql -m migrations",
    "migrate:up": "node-pg-migrate up --migration-file-language sql -m migrations",
    "migrate:down": "node-pg-migrate down --migration-file-language sql -m migrations",
    "migrate:create": "node-pg-migrate create --migration-file-language sql -m migrations",
    "migrate:central:up": "node-pg-migrate up --migration-file-language sql -m migrations -d DATABASE_URL",
    "migrate:central:down": "node-pg-migrate down --migration-file-language sql -m migrations -d DATABASE_URL",
    "migrate:central:plan": "node-pg-migrate up --dry-run --migration-file-language sql -m migrations -d DATABASE_URL",
    "migrate:central:create": "node-pg-migrate create --migration-file-language sql -m migrations",
    "migrate:agent:up": "node-pg-migrate up --migration-file-language sql -m migrations-agent -d AGENT_DATABASE_URL",
    "migrate:agent:down": "node-pg-migrate down --migration-file-language sql -m migrations-agent -d AGENT_DATABASE_URL",
    "migrate:agent:plan": "node-pg-migrate up --dry-run --migration-file-language sql -m migrations-agent -d AGENT_DATABASE_URL",
    "migrate:agent:create": "node-pg-migrate create --migration-file-language sql -m migrations-agent",
    "create-admin": "ts-node scripts/create-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^8.1.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "kysely": "^0.27.4",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.9.1",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "roots": [
      "<rootDir>",
      "<rootDir>/../test/real-db-e2e"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
