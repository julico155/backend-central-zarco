# Postgres propio del backend central (Supabase como proveedor, credenciales
# propias — nunca la service_role key de Supabase).
DATABASE_URL=postgres://user:password@host:5432/backend_central

PORT=3000

# Orígenes permitidos por CORS, separados por coma. Necesario para cualquier
# front en el navegador (POS, dashboard); los clientes que no son navegadores
# (gateway de WhatsApp, Postman) no lo necesitan. Vacío = ningún origen.
CORS_ORIGINS=http://localhost:5173

# Tokens estáticos por servicio cliente (bearer, comparación timing-safe).
# Cada api_client autorizado a llamar a este backend tiene su propio token.
# Formato: <api_client>:<token>,<api_client>:<token>,...
# Un token por cliente de servicio; el nombre decide el canal de sus pedidos: whatsapp-gateway = whatsapp, web = web.
# No definas uno llamado "pos": el POS usa JWT de staff, nunca un token de servicio.
SERVICE_AUTH_TOKENS=whatsapp-gateway:changeme

# Cliente HTTP hacia el "gateway API" de saas_smarky (avisos salientes).
GATEWAY_BASE_URL=http://localhost:4000
GATEWAY_AUTH_TOKEN=changeme
# Máximo 60000 ms; default 30000 ms. Debe quedar bajo el lease de avisos (5 min).
GATEWAY_TIMEOUT_MS=30000

# Entrada WhatsApp/Kapso. Estas variables no habilitan tráfico por sí mismas:
# el webhook solo existe al desplegar esta aplicación y se mantiene sin lógica
# comercial hasta la siguiente fase.
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
KAPSO_PHONE_NUMBER_ID=
KAPSO_API_BASE_URL=https://api.kapso.ai
# Solo la cadena exacta true responde tras persistir; cualquier otro valor
# conserva el procesamiento inline.
WEBHOOK_ASYNC_ACK=

# JWT de sesión de staff (dashboard_users) — distinto del bearer estático
# entre servicios. Generar con: openssl rand -base64 48
JWT_SECRET=changeme
JWT_EXPIRES_IN=8h

# Distancia real de calle para delivery (Mapbox Directions API). Vacío =
# DeliveryModule usa línea recta (haversine) automáticamente, sin tocar
# código. Crear en https://account.mapbox.com/access-tokens/.
MAPBOX_ACCESS_TOKEN=

# Storage de comprobantes de pago (S3 o S3-compatible: Cloudflare R2, MinIO,
# etc.). Vacío (sin bucket) = PaymentProofsModule usa disco local
# automáticamente, sin tocar código. Dejar PAYMENT_PROOFS_S3_ENDPOINT vacío
# para AWS S3; setearlo para cualquier otro proveedor S3-compatible (en R2,
# es https://<account_id>.r2.cloudflarestorage.com).
PAYMENT_PROOFS_S3_BUCKET=
PAYMENT_PROOFS_S3_REGION=auto
PAYMENT_PROOFS_S3_ACCESS_KEY_ID=
PAYMENT_PROOFS_S3_SECRET_ACCESS_KEY=
PAYMENT_PROOFS_S3_ENDPOINT=

# API QR de Banco Económico (cobro real). Certificación:
# https://apimktdesa.baneco.com.bo/ApiGateway/ — ver
# Manual_Integracion_API_QR_Banco_Economico_Smarky.pdf para el resto de las
# credenciales (usuario/password/AES key/cuenta las entrega el banco, nunca
# van en este archivo ni en el repo).
BANECO_BASE_URL=
BANECO_USERNAME=
BANECO_PASSWORD=
BANECO_AES_KEY=
BANECO_ACCOUNT=

# 'manual' = mientras el banco no habilite producción del QR: el POS ya no
# puede pedir un QR real (POST /orders/:id/qr/generate da 409
# qr_manual_mode), el cajero confirma el cobro a mano con
# POST /orders/:id/payment-attempts/confirm-presencial. Solo afecta
# channel='pos' — WhatsApp no se toca. Vacío o cualquier otro valor = modo
# normal (QR real de Baneco). Sacar esta variable en Railway apenas el
# banco dé el ok a producción.
POS_QR_MODE=

# Minutos tras los que un pedido sin pagar (WhatsApp o POS) se cancela solo. Default 10.
UNPAID_ORDER_TTL_MINUTES=

# Radio en metros alrededor del local dentro del cual un repartidor puede aceptar un pedido. Default 150.
DELIVERY_ACCEPT_RADIUS_METERS=

# Radio en metros entre dos pedidos DISPONIBLES (todavía sin aceptar) para
# reportarlos como cercanos entre sí en GET /delivery/orders/available — nunca
# se expone la ubicación cruda del cliente antes de aceptar. Default 500.
DELIVERY_NEARBY_RADIUS_METERS=

# Agente conversacional (SarcoAgentModule, Fase 2B). Nada de esto activa
# tráfico real por sí solo: sin OPENAI_API_KEY el agente queda en
# not_configured, y sin AI_ENABLED=true (exacto) queda apagado.
OPENAI_API_KEY=
# Vacío = gpt-4o-mini.
OPENAI_MODEL=
# Modelo para turnos con foto. Vacío = se usa OPENAI_MODEL.
AI_VISION_MODEL=
# Solo la cadena exacta true enciende el agente. Cualquier otro valor lo deja apagado.
AI_ENABLED=
# Solo 'all' abre el agente a cualquier cliente. Cualquier otro valor (o vacío)
# cae en 'allowlist': solo responde a los teléfonos de AI_TEST_PHONES.
AI_ACCESS_MODE=
# Teléfonos de prueba en modo allowlist, separados por coma (dígitos, con o sin +).
AI_TEST_PHONES=
# Respaldo de la forma anterior de AI_TEST_PHONES (un solo teléfono).
AI_TEST_PHONE=
# Minutos que se pausa el agente tras un mensaje humano desde WhatsApp
# Business App (takeover). Vacío o inválido = 30.
HUMAN_TAKEOVER_PAUSE_MINUTES=
