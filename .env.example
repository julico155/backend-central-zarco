# Postgres propio del backend central (Supabase como proveedor, credenciales
# propias — nunca la service_role key de Supabase).
DATABASE_URL=postgres://user:password@host:5432/backend_central

PORT=3000

# Tokens estáticos por servicio cliente (bearer, comparación timing-safe).
# Cada api_client autorizado a llamar a este backend tiene su propio token.
# Formato: <api_client>:<token>,<api_client>:<token>,...
SERVICE_AUTH_TOKENS=whatsapp-gateway:changeme,pos:changeme,web:changeme

# Cliente HTTP hacia el "gateway API" de saas_smarky (avisos salientes).
GATEWAY_BASE_URL=http://localhost:4000
GATEWAY_AUTH_TOKEN=changeme
